<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained DANBOT.exe: the .NET runtime, the ui folder and the
  WebView2 loader are bundled and unpacked on first run.

  Dev / unobfuscated publish:
    dotnet publish HappyBot.csproj -p:PublishProfile=SingleExe
  Output: publish\DANBOT.exe

  Release build ORDER (obfuscation must happen before bundling, signing last):
    1. dotnet publish HappyBot.csproj -p:PublishProfile=SingleExe -p:Obfuscate=true
         Obfuscar renames HappyBot's IL and encrypts its strings on the
         compiled assembly BEFORE it is bundled into DANBOT.exe (see
         obfuscate.targets / obfuscar.xml). If the in-build hook misbehaves,
         use tools/obfuscate-release.ps1 instead.
    2. node tools/release.mjs            (hashes + signs the FINAL
                                          publish\DANBOT.exe, so it runs LAST)
  See README "Obfuscated release build".
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <AssemblyName>DANBOT</AssemblyName>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>
</Project>
